{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_WORKFLOWS": "1"
  },
  "permissions": {
    "defaultMode": "auto"
  },
  "enabledPlugins": {
    "agent-sdk-dev@claude-plugins-official": true,
    "ralph-loop@claude-plugins-official": false,
    "superpowers@claude-plugins-official": false,
    "frontend-design@claude-plugins-official": false,
    "deploy-on-aws@claude-plugins-official": true,
    "warp@claude-code-warp": true,
    "plannotator@plannotator": true
  },
  "extraKnownMarketplaces": {
    "agent-plugins-for-aws": {
      "source": {
        "source": "github",
        "repo": "awslabs/agent-plugins"
      },
      "autoUpdate": true
    },
    "claude-code-warp": {
      "source": {
        "source": "github",
        "repo": "warpdotdev/claude-code-warp"
      }
    },
    "plannotator": {
      "source": {
        "source": "github",
        "repo": "backnotprop/plannotator"
      },
      "autoUpdate": true
    },
    "thingos-internal": {
      "source": {
        "source": "file",
        "path": "/Users/suddenlygiovanni/Developer/work/headless/claude/effect-lsp/.claude-plugin/marketplace.json"
      }
    }
  },
  "effortLevel": "high",
  "tui": "fullscreen",
  "autoDreamEnabled": true,
  "theme": "auto",
  "verbose": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "voiceEnabled": true
}
