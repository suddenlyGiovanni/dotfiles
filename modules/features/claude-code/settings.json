{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_WORKFLOWS": "1",
    "CLAUDE_BASH_MAINTAIN_PROJECT_WORKING_DIR": "1"
  },
  "permissions": {
    "defaultMode": "auto"
  },
  "model": "opus[1m]",
  "enabledPlugins": {
    "agent-sdk-dev@claude-plugins-official": true,
    "ralph-loop@claude-plugins-official": false,
    "superpowers@claude-plugins-official": false,
    "frontend-design@claude-plugins-official": false,
    "deploy-on-aws@claude-plugins-official": true,
    "plannotator@plannotator": true,
    "cloudflare@cloudflare": true,
    "warp@claude-code-warp": true
  },
  "extraKnownMarketplaces": {
    "agent-plugins-for-aws": {
      "source": {
        "source": "github",
        "repo": "awslabs/agent-plugins"
      },
      "autoUpdate": true
    },
    "claude-code-warp": {
      "source": {
        "source": "github",
        "repo": "warpdotdev/claude-code-warp"
      }
    },
    "plannotator": {
      "source": {
        "source": "github",
        "repo": "backnotprop/plannotator"
      },
      "autoUpdate": true
    },
    "thingos-internal": {
      "source": {
        "source": "file",
        "path": "/Users/suddenlygiovanni/Developer/work/headless/claude/effect-lsp/.claude-plugin/marketplace.json"
      },
      "autoUpdate": true
    },
    "vladikk-modularity": {
      "source": {
        "source": "git",
        "url": "https://github.com/vladikk/modularity.git"
      }
    },
    "cloudflare": {
      "source": {
        "source": "github",
        "repo": "cloudflare/skills"
      }
    }
  },
  "effortLevel": "high",
  "tui": "fullscreen",
  "autoMemoryEnabled": false,
  "autoDreamEnabled": true,
  "skipWorkflowUsageWarning": true,
  "theme": "auto",
  "verbose": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "voiceEnabled": true
}
