# Agent tier - credentials an agent session may use with no user present
# docs/research/afk-credentials.md
#
# The user's own credentials ask for Touch ID: 1Password signs commits and
# answers SSH (git/default.nix, ssh.nix). That fits a person. An agent then
# stalls when nobody is there, and holds the user's keys when somebody is.
#
# So an agent session gets its own, narrower set, and never the user's:
#
#   Push, fetch   HTTPS, the token comes from the CLI's keychain entry through
#                 a credential helper (gh for github.com, glab for the work
#                 GitLab). git asks the helper over a pipe; the token is in no
#                 environment variable.
#   Signing       ~/.ssh/agent-signing, an Ed25519 key on disk with no
#                 passphrase. It signs commits and nothing else: register it on
#                 the forge as a SIGNING key only, never for authentication.
#                 A commit it signs is verified and distinguishable from one
#                 the user signed.
#   SSH from git  Off. A remote that has no HTTPS rewrite below fails in under
#                 a second, where the 1Password agent would wait for a finger.
#   AWS           No configuration. Every profile on the work host is an
#                 administrator role; operations stay with the user.
#
# TWO FILES, ONE SWITCH
#
# - ~/.config/git/agent.gitconfig: the user's git configuration (included),
#   then the overrides. git reads it in place of the global file when
#   GIT_CONFIG_GLOBAL names it.
# - ~/.config/agent-tier/env.sh: the exports that turn the tier on. A harness
#   sources it before each command it runs. For Claude Code that is
#   claude-code/hooks/direnv-env.nu; a terminal never sources it, so the
#   user's own git is unchanged.
#
# The exports hold settings and paths only, no secret.
#
# ONE-TIME SETUP PER MACHINE
#
# Activation creates the key when it is missing (outside the Nix store). Then
# run `agent-tier-check` (check.nu): it tests the logins, the credential
# helpers and the key, and prints the command for each gap. Until the key is
# registered, the forge shows the agent's commits as unverified.
#
# The key belongs to one machine and is in no vault. A new machine gets a new
# key from its first switch. To retire a key: delete it on the forge, then
# remove both files in ~/.ssh. docs/AGENT-TIER.md has the full runbook.
_: {
  flake.modules.homeManager.agent-tier = {
    config,
    lib,
    pkgs,
    ...
  }: let
    inherit (config.dotfiles) isWorkHost;

    signingKey = "${config.home.homeDirectory}/.ssh/agent-signing";
    gitConfig = "${config.xdg.configHome}/git/agent.gitconfig";
    envFile = "${config.xdg.configHome}/agent-tier/env.sh";
    sshKeygen = "${pkgs.openssh}/bin/ssh-keygen";

    # Who may sign as the user: every email the git identities use, and the
    # user's signing key without its comment.
    allowedSigners = "${config.xdg.configHome}/git/allowed_signers";
    signerPrincipals = lib.concatStringsSep "," (lib.unique (
      [config.programs.git.settings.user.email]
      ++ lib.filter (email: email != null) (
        map (lib.attrByPath ["contents" "user" "email"] null) config.programs.git.includes
      )
    ));
    userSigningKey = lib.concatStringsSep " " (lib.take 2 (lib.splitString " " config.dotfiles.sshKeys.git-signing));

    # Where the agent pushes, and the CLI whose keychain entry holds the token.
    forges =
      [
        {
          host = "github.com";
          cli = "gh";
        }
      ]
      ++ lib.optionals isWorkHost [
        {
          host = "dev.thingos.io";
          cli = "glab";
        }
      ];

    # agent-tier-check: what this machine still needs, and the command for each gap.
    checkData = pkgs.writeText "agent-tier-check.json" (builtins.toJSON {
      inherit envFile gitConfig signingKey forges;
    });
    agent-tier-check = pkgs.writeShellScriptBin "agent-tier-check" ''
      exec ${lib.getExe pkgs.nushell} --no-config-file ${./check.nu} ${checkData}
    '';

    # Both spellings of an SSH remote, rewritten to HTTPS.
    httpsFor = host: ''
      [url "https://${host}/"]
      	insteadOf = git@${host}:
      	insteadOf = ssh://git@${host}/
    '';
  in {
    xdg.configFile = {
      # The overrides come after the include: for a key set twice, git takes the
      # last value, and the user's identity includes set user.signingkey too.
      "git/agent.gitconfig".text =
        ''
          # Generated by modules/features/agent-tier/default.nix. git reads this file in
          # place of the global one when GIT_CONFIG_GLOBAL names it.
          [include]
          	path = ${config.xdg.configHome}/git/config

          [gpg]
          	format = ssh
          [gpg "ssh"]
          	program = ${sshKeygen}
          [user]
          	signingkey = ${signingKey}

          # github.com: the user's configuration already sets gh as the helper.
          ${httpsFor "github.com"}
        ''
        + lib.optionalString isWorkHost ''
          ${httpsFor "dev.thingos.io"}
          # The empty value clears the helpers inherited for this host.
          [credential "https://dev.thingos.io"]
          	helper =
          	helper = ${lib.getExe pkgs.glab} auth git-credential
        '';

      "agent-tier/env.sh".text = ''
        # Generated by modules/features/agent-tier/default.nix. An agent harness sources
        # this before each command it runs. Settings and paths only, no secret.
        export AGENT_TIER=1
        export GIT_CONFIG_GLOBAL=${lib.escapeShellArg gitConfig}
        export GIT_SSH_COMMAND='ssh -o IdentityAgent=none -o BatchMode=yes'
        export AWS_CONFIG_FILE=/dev/null
        export AWS_SHARED_CREDENTIALS_FILE=/dev/null
        unset AWS_PROFILE AWS_DEFAULT_PROFILE
      '';
    };

    # `git log --show-signature` checks a signature against this file. The forges
    # do their own check against the keys registered there.
    programs.git.settings.gpg.ssh.allowedSignersFile = allowedSigners;

    home = {
      packages = [agent-tier-check];

      activation = {
        # `hostname` can be a DHCP name; LocalHostName is the name macOS shows.
        agentSigningKey = lib.hm.dag.entryAfter ["writeBoundary"] ''
          if [ ! -f ${lib.escapeShellArg signingKey} ]; then
            run mkdir -p ${lib.escapeShellArg (dirOf signingKey)}
            run ${sshKeygen} -q -t ed25519 -N "" \
              -C "agent signing key ($(/usr/sbin/scutil --get LocalHostName))" \
              -f ${lib.escapeShellArg signingKey}
            noteEcho "Created ${signingKey}. Run agent-tier-check: it prints the commands that register it."
          fi
        '';

        # One line per key that may sign as the user: the user's own key (known to
        # Nix) and this machine's agent key (made above, so read here). Written at
        # activation because the agent key is not in the Nix store.
        gitAllowedSigners = lib.hm.dag.entryAfter ["agentSigningKey"] ''
          if [[ ! -v DRY_RUN ]]; then
            {
              echo ${lib.escapeShellArg "${signerPrincipals} ${userSigningKey}"}
              if [ -f ${lib.escapeShellArg "${signingKey}.pub"} ]; then
                echo ${lib.escapeShellArg signerPrincipals} "$(${pkgs.coreutils}/bin/cut -d' ' -f1,2 ${lib.escapeShellArg "${signingKey}.pub"})"
              fi
            } > ${lib.escapeShellArg allowedSigners}
          fi
        '';
      };
    };
  };
}
