{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enabledMcpjsonServers": ["mcpls"],
  "enabledPlugins": {
    "dotfiles-lsp@dotfiles": true
  },
  "extraKnownMarketplaces": {
    "dotfiles": {
      "source": {
        "source": "file",
        "path": ".claude-plugin/marketplace.json"
      }
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "nu --stdin \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/direnv-prime.nu",
            "timeout": 120
          }
        ]
      }
    ],
    "CwdChanged": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "nu --stdin \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/direnv-prime.nu",
            "timeout": 120
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "nu --stdin \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/pre-tool-use.nu",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "direnv exec \"$CLAUDE_PROJECT_DIR\" nu --stdin \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/post-tool-use.nu",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "direnv exec \"$CLAUDE_PROJECT_DIR\" nu --stdin \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/stop-gate.nu",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
