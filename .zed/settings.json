// Project settings for the dotfiles repo (layered over the global ones in
// modules/features/zed/settings.json).
//
// Format through treefmt (perSystem.treefmt in flake.nix), the same table
// `just fmt`, `nix fmt`, the treefmt flake check and the Claude Code hook use.
// The `treefmt` command is a wrapper with that table baked in; it comes from
// the flake devshell, which Zed loads via direnv.
{
	"git": {
		"worktree_directory": ".worktrees",
	},
  "languages": {
    "Nix": {
      "formatter": {
        "external": {
          "command": "treefmt",
          "arguments": ["--stdin", "{buffer_path}"],
        },
      },
    },
    "Nu": {
      "formatter": {
        "external": {
          "command": "treefmt",
          "arguments": ["--stdin", "{buffer_path}"],
        },
      },
    },
    "Lua": {
      "formatter": {
        "external": {
          "command": "treefmt",
          "arguments": ["--stdin", "{buffer_path}"],
        },
      },
    },
  },
}
